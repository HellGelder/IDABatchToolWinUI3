<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <!-- xUnit v3: тесты — обычное консольное приложение, без testhost.
         В этом окружении testhost падает на OpenProcess(parent) с access denied,
         а MTP-раннер работает напрямую: запуск через dotnet run по проекту. -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!--
    Тестируем только чистую логику: исходники линкуются, чтобы не тянуть
    WinUI-приложение и Windows App SDK в тестовый процесс.
  -->
  <ItemGroup>
    <Compile Include="..\..\Services\ArtifactValidator.cs" Link="Linked\ArtifactValidator.cs" />
    <Compile Include="..\..\Services\ArtifactCleanup.cs" Link="Linked\ArtifactCleanup.cs" />
    <Compile Include="..\..\Services\AppLog.cs" Link="Linked\AppLog.cs" />
    <Compile Include="..\..\Services\OutcomeTracker.cs" Link="Linked\OutcomeTracker.cs" />
    <Compile Include="..\..\Services\ProcessRegistry.cs" Link="Linked\ProcessRegistry.cs" />
    <Compile Include="..\..\Services\ProcessPulse.cs" Link="Linked\ProcessPulse.cs" />
    <Compile Include="..\..\Services\JobObject.cs" Link="Linked\JobObject.cs" />
    <Compile Include="..\..\Services\ProcessRunner.cs" Link="Linked\ProcessRunner.cs" />
    <Compile Include="..\..\Diff\HexdumpDiffService.cs" Link="Linked\HexdumpDiffService.cs" />
    <Compile Include="..\..\Diff\DiffJson.cs" Link="Linked\DiffJson.cs" />
    <Compile Include="..\..\Models\FileItem.cs" Link="Linked\FileItem.cs" />
    <Compile Include="..\..\Services\AppConstants.cs" Link="Linked\AppConstants.cs" />
    <Compile Include="..\..\Services\ConfigService.cs" Link="Linked\ConfigService.cs" />
    <Compile Include="..\..\Services\ConfigStore.cs" Link="Linked\ConfigStore.cs" />
    <Compile Include="..\..\Diff\BinDiffParser.cs" Link="Linked\BinDiffParser.cs" />
    <Compile Include="..\..\Diff\DiaphoraParser.cs" Link="Linked\DiaphoraParser.cs" />
