<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <!-- xUnit v3: тесты — обычное консольное приложение, без testhost.
         В этом окружении testhost падает на OpenProcess(parent) с access denied,
         а MTP-раннер работает напрямую: запуск через dotnet run по проекту. -->
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!--
    Тестируем только чистую логику: исходники линкуются, чтобы не тянуть
    WinUI-приложение и Windows App SDK в тестовый процесс.
  -->
  <ItemGroup>
    <Compile Include="..\..\Services\ArtifactValidator.cs" Link="Linked\ArtifactValidator.cs" />
    <Compile Include="..\..\Services\OutcomeTracker.cs" Link="Linked\OutcomeTracker.cs" />
  </ItemGroup>

</Project>
