# --- ZCode / AI skills ---
.zcode/plans/
.zcode/commands/

# --- graphify knowledge graph ---
# Коммитим переносимые артефакты (карта для команды), игнорируем кэш и машино-специфику.
# Порядок правил важен: ignore всё ниже, затем явно re-include.
graphify-out/*

# Переносимые артефакты — коммитим (см. SKILLS.md)
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.html

# Кэш и машино-специфика — игнорируем (последнее совпадение выигрывает)
graphify-out/.graphify_analysis.json
graphify-out/.graphify_labels.json
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_root
graphify-out/.graphify_python
graphify-out/.vocab.txt
graphify-out/.graphify_cached.json
graphify-out/cache/
graphify-out/manifest.json