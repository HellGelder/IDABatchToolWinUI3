<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IDABatchToolWinUI.Pages.DiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IDABatchToolWinUI.Pages"
    xmlns:models="using:IDABatchToolWinUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Директории -->
            <Border Grid.Row="0" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Директории для сравнения" Style="{StaticResource GroupHeaderStyle}" />

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Левая (эталонная):"
                                   VerticalAlignment="Center" MinWidth="120" FontSize="13" />
                        <TextBox x:Name="LeftDirTextBox" Grid.Column="1"
                                 PlaceholderText="Путь к папке с .i64 файлами..." />
                        <Button x:Name="BrowseLeftButton" Grid.Column="2" Content="Обзор..." MinWidth="70"
                                Padding="8,4" />
                    </Grid>

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Правая (текущая):"
                                   VerticalAlignment="Center" MinWidth="120" FontSize="13" />
                        <TextBox x:Name="RightDirTextBox" Grid.Column="1"
                                 PlaceholderText="Путь к папке с .i64 файлами..." />
                        <Button x:Name="BrowseRightButton" Grid.Column="2" Content="Обзор..." MinWidth="70"
                                Padding="8,4" />
                    </Grid>

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Папка результатов:"
                                   VerticalAlignment="Center" MinWidth="120" FontSize="13" />
                        <TextBox x:Name="OutputDirTextBox" Grid.Column="1"
                                 PlaceholderText="Автоматически: DiffResults в левой папке" />
                        <Button x:Name="BrowseOutputButton" Grid.Column="2" Content="Обзор..." MinWidth="70"
                                Padding="8,4" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Движок сравнения -->
            <Border Grid.Row="1" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Движок сравнения" Style="{StaticResource GroupHeaderStyle}" />
                    <RadioButton x:Name="EngineBindiff" GroupName="DiffEngine" Content="Только BinDiff" IsChecked="True"
                                Padding="2,2" />
                    <RadioButton x:Name="EngineDiaphora" GroupName="DiffEngine" Content="Только Diaphora"
                                Padding="2,2" />
                    <RadioButton x:Name="EngineBoth" GroupName="DiffEngine" Content="Оба движка"
                                Padding="2,2" />
                </StackPanel>
            </Border>

            <!-- Сопоставленные пары -->
            <Border Grid.Row="2" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Сопоставленные пары (отметьте для сравнения)" Style="{StaticResource GroupHeaderStyle}" />
                    <ListView x:Name="PairsListView" MaxHeight="260" MinHeight="80"
                              SelectionMode="None">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="6" Padding="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="HeaderCheckBox" Grid.Column="0" IsChecked="True"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Файл" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="2" Text="Размер" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="3" Text="Статус" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="4" Text="BinDiff" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock Grid.Column="5" Text="Diaphora" FontWeight="SemiBold" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PairRowViewModel">
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind RelKey}" TextWrapping="NoWrap"
                                               ToolTipService.ToolTip="{x:Bind ToolTip}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind StatusText}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind BindiffStatus}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind DiaphoraStatus}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="MapStatusLabel" Text="Укажите обе директории для анализа."
                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Прогресс -->
            <Border Grid.Row="3" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Прогресс выполнения" Style="{StaticResource GroupHeaderStyle}" />
                    <TextBlock x:Name="ProgressLabel" Text="Прогресс выполнения: ожидание..."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
                    <ProgressBar x:Name="DiffProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" />
                </StackPanel>
            </Border>

            <!-- Кнопки управления -->
            <Border Grid.Row="4" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Управление" Style="{StaticResource GroupHeaderStyle}" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartDiffButton" Grid.Column="0" Content="Запустить сравнение"
                                Height="34" Width="160" Padding="12,6" IsEnabled="False" />
                        <Button x:Name="CancelDiffButton" Grid.Column="1" Content="Отмена"
                                Height="34" Width="80" Padding="12,6" IsEnabled="False" />
                        <Button x:Name="GenerateReportButton" Grid.Column="3" Content="Сгенерировать HTML-отчёт"
                                Height="34" Width="180" Padding="12,6" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ошибки -->
            <Border Grid.Row="5" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Сообщения об ошибках" Style="{StaticResource GroupHeaderStyle}" />
                    <TextBox x:Name="DiffErrorTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                             IsReadOnly="True" MaxHeight="50" MinHeight="30"
                             PlaceholderText="Здесь будут появляться сообщения об ошибках..." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>