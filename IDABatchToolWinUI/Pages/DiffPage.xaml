<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IDABatchToolWinUI.Pages.DiffPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IDABatchToolWinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="20,20,20,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Директории -->
            <Border Grid.Row="0" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Директории для сравнения" Style="{StaticResource GroupHeaderStyle}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Левая (эталонная):"
                                   VerticalAlignment="Center" MinWidth="130" />
                        <TextBox x:Name="LeftDirTextBox" Grid.Column="1"
                                 PlaceholderText="Путь к папке с .i64 файлами..." />
                        <Button x:Name="BrowseLeftButton" Grid.Column="2" Content="Обзор..." MinWidth="90" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Правая (текущая):"
                                   VerticalAlignment="Center" MinWidth="130" />
                        <TextBox x:Name="RightDirTextBox" Grid.Column="1"
                                 PlaceholderText="Путь к папке с .i64 файлами..." />
                        <Button x:Name="BrowseRightButton" Grid.Column="2" Content="Обзор..." MinWidth="90" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Папка результатов:"
                                   VerticalAlignment="Center" MinWidth="130" />
                        <TextBox x:Name="OutputDirTextBox" Grid.Column="1"
                                 PlaceholderText="Автоматически: DiffResults в левой папке" />
                        <Button x:Name="BrowseOutputButton" Grid.Column="2" Content="Обзор..." MinWidth="90" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Движок сравнения -->
            <Border Grid.Row="1" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Движок сравнения" Style="{StaticResource GroupHeaderStyle}" />
                    <RadioButton x:Name="EngineBindiff" GroupName="DiffEngine" Content="Только BinDiff" IsChecked="True" />
                    <RadioButton x:Name="EngineDiaphora" GroupName="DiffEngine" Content="Только Diaphora" />
                    <RadioButton x:Name="EngineBoth" GroupName="DiffEngine" Content="Оба движка" />
                </StackPanel>
            </Border>

            <!-- Прогресс -->
            <Border Grid.Row="2" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Прогресс выполнения" Style="{StaticResource GroupHeaderStyle}" />
                    <TextBlock x:Name="ProgressLabel" Text="Прогресс выполнения: ожидание..."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="DiffProgressBar" Minimum="0" Maximum="100" Value="0" />
                </StackPanel>
            </Border>

            <!-- Кнопки управления -->
            <Border Grid.Row="3" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Управление" Style="{StaticResource GroupHeaderStyle}" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartDiffButton" Grid.Column="0" Content="Запустить сравнение"
                                Height="40" Width="180" IsEnabled="False" />
                        <Button x:Name="CancelDiffButton" Grid.Column="1" Content="Отмена"
                                Height="40" Width="100" IsEnabled="False" />
                        <Button x:Name="GenerateReportButton" Grid.Column="3" Content="Сгенерировать HTML-отчёт"
                                Height="40" Width="200" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ошибки -->
            <Border Grid.Row="4" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Сообщения об ошибках" Style="{StaticResource GroupHeaderStyle}" />
                    <TextBox x:Name="DiffErrorTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                             IsReadOnly="True" MaxHeight="60" MinHeight="40"
                             PlaceholderText="Здесь будут появляться сообщения об ошибках..." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>