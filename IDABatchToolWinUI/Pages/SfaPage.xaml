<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IDABatchToolWinUI.Pages.SfaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ctl="using:IDABatchToolWinUI.Controls"
    xmlns:local="using:IDABatchToolWinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="{StaticResource PagePadding}" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Источник файлов -->
            <Border Grid.Row="0" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Источник файлов" Style="{StaticResource GroupHeaderStyle}" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SfaInputDirTextBox" Grid.Column="0"
                                 PlaceholderText="Путь к папке с бинарными файлами или к архиву..." />
                        <Button x:Name="SfaBrowseDirButton" Grid.Column="1" Content="Обзор..." MinWidth="80" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Графическое отображение директории -->
            <Border Grid.Row="1" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Графическое отображение директории" Style="{StaticResource GroupHeaderStyle}" />
                    <ctl:TreemapControl x:Name="SfaTreemap" Height="40" />
                </StackPanel>
            </Border>

            <!-- Автоопределение платформы: неотключаемый инфобар под тремапом -->
            <InfoBar Grid.Row="2" x:Name="SfaPlatformInfoBar" IsOpen="False" IsClosable="False"
                     Severity="Informational" />

            <!-- Параметры (во всю ширину): чекбоксы 2+2, ниже — потоки IDA -->
            <Border Grid.Row="3" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Параметры" Style="{StaticResource GroupHeaderStyle}" />
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="6">
                            <CheckBox x:Name="SfaCleanupCheck" Content="Удалять .asm и .log после успешного анализа"
                                      IsChecked="True" Padding="2,1,2,1" />
                            <CheckBox x:Name="SfaTempCleanupCheck" Content="Удалять временные файлы IDA (.id0, .id1, .nam, .til)"
                                      IsChecked="True" Padding="2,1,2,1" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                            <CheckBox x:Name="SfaPseudocodeCheck" Content="Включить псевдокод в JSON-экспорт"
                                      IsChecked="True" Padding="2,1,2,1" />
                            <CheckBox x:Name="SfaDeleteJsonCheck" Content="Удалить JSON-файлы после создания отчётов"
                                      IsChecked="True" Padding="2,1,2,1" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Потоков IDA:" VerticalAlignment="Center" FontSize="13" />
                        <Slider x:Name="SfaMaxIdaSlider" Grid.Column="1" Minimum="1" Maximum="32" Value="4"
                                StepFrequency="1" TickFrequency="4"
                                ToolTipService.ToolTip="Максимальное количество одновременно работающих экземпляров IDA." />
                        <TextBlock Grid.Column="2" Text="{Binding ElementName=SfaMaxIdaSlider, Path=Value}"
                                   VerticalAlignment="Center" MinWidth="20" TextAlignment="Center"
                                   FontSize="13" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Процесс анализа СФ -->
            <Border Grid.Row="4" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Процесс анализа СФ" Style="{StaticResource GroupHeaderStyle}" />
                    <TextBlock x:Name="SfaProcessStatusText" Text="Готов к запуску" FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="SfaProcessProgress" Minimum="0" Maximum="100" Value="0" Height="4" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="SfaStartButton" Grid.Column="0" Content="Запустить анализ СФ"
                                Height="34" Width="160" Padding="12,6" />
                        <Button x:Name="SfaCancelButton" Grid.Column="1" Content="Отмена"
                                Height="34" Width="80" Padding="12,6" IsEnabled="False" />
                        <Button x:Name="SfaGenerateHtmlButton" Grid.Column="3" Content="Сгенерировать HTML-отчёт СФ"
                                Height="34" Width="200" Padding="12,6" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ошибки -->
            <Border Grid.Row="5" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Сообщения об ошибках" Style="{StaticResource GroupHeaderStyle}" />
                    <TextBox x:Name="SfaErrorLogTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                             IsReadOnly="True" MaxHeight="120" MinHeight="40"
                             PlaceholderText="Ошибки..." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>