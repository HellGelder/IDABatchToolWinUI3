<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IDABatchToolWinUI.Pages.AnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:IDABatchToolWinUI.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="GroupBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="GroupHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="20,20,20,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Источник файлов -->
            <Border Grid.Row="0" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Источник файлов" Style="{StaticResource GroupHeaderStyle}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputDirTextBox" Grid.Column="0"
                                 PlaceholderText="Путь к папке с бинарными файлами или к архиву (.apk, .ipa, .dmg)..." />
                        <Button x:Name="BrowseDirButton" Grid.Column="1" Content="Обзор..." MinWidth="100" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Параметры сканирования -->
            <Border Grid.Row="1" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Параметры сканирования" Style="{StaticResource GroupHeaderStyle}" />
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Левая колонка -->
                        <StackPanel Grid.Column="0" Spacing="12">
                            <!-- Целевая платформа -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Целевая платформа" FontWeight="SemiBold" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="PlatformWindows" Grid.Row="0" Grid.Column="0"
                                                 GroupName="AnalysisPlatform" Content="Windows" IsChecked="True"
                                                 Margin="0,0,20,4" />
                                    <RadioButton x:Name="PlatformLinuxAndroid" Grid.Row="0" Grid.Column="1"
                                                 GroupName="AnalysisPlatform" Content="Linux / Android"
                                                 Margin="0,0,0,4" />
                                    <RadioButton x:Name="PlatformMacIos" Grid.Row="1" Grid.Column="0"
                                                 GroupName="AnalysisPlatform" Content="macOS / iOS" />
                                </Grid>
                            </StackPanel>

                            <!-- Потоки IDA -->
                            <StackPanel Spacing="4">
                                <TextBlock Text="Потоков IDA:" />
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MaxIdaSlider" Grid.Column="0" Minimum="1" Maximum="32" Value="4"
                                            StepFrequency="1" TickFrequency="4" />
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=MaxIdaSlider, Path=Value}"
                                               VerticalAlignment="Center" MinWidth="24" TextAlignment="Center"
                                               FontSize="14" FontWeight="SemiBold" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- Правая колонка: Флаги анализа -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Флаги анализа" FontWeight="SemiBold" />
                            <CheckBox x:Name="CleanupCheck" Content="Удалять .asm и .log после успешного анализа"
                                      IsChecked="True" Margin="0,0,0,4" />
                            <CheckBox x:Name="TempCleanupCheck" Content="Удалять временные файлы IDA (.id0, .id1, .nam, .til)"
                                      IsChecked="True" Margin="0,0,0,4" />
                            <CheckBox x:Name="PseudocodeCheck" Content="Включить псевдокод в JSON-экспорт"
                                      IsChecked="True" Margin="0,0,0,4" />
                            <CheckBox x:Name="DeleteJsonCheck" Content="Удалить JSON-файлы после создания отчётов"
                                      IsChecked="True" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Процесс анализа -->
            <Border Grid.Row="2" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Процесс анализа" Style="{StaticResource GroupHeaderStyle}" />
                    <TextBlock x:Name="ProcessStatusText" Text="Готов к запуску" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ProgressBar x:Name="ProcessProgress" Minimum="0" Maximum="100" Value="0" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartAnalysisButton" Grid.Column="0" Content="Запустить анализ"
                                Height="40" Width="160" />
                        <Button x:Name="CancelButton" Grid.Column="1" Content="Отмена"
                                Height="40" Width="100" IsEnabled="False" />
                        <Button x:Name="GenerateHtmlButton" Grid.Column="3" Content="Сгенерировать HTML-отчёты"
                                Height="40" Width="200" IsEnabled="False" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Ошибки -->
            <Border Grid.Row="3" Style="{StaticResource GroupBoxStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Сообщения об ошибках" Style="{StaticResource GroupHeaderStyle}" />
                    <TextBox x:Name="ErrorLogTextBox" AcceptsReturn="True" TextWrapping="Wrap"
                             IsReadOnly="True" MaxHeight="150" MinHeight="60"
                             PlaceholderText="Здесь будут появляться сообщения об ошибках..." />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>