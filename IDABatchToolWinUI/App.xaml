<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="IDABatchToolWinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IDABatchToolWinUI">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Compact sizing - общее уплотнение элементов -->
            <!-- NavigationView compact -->
            <x:Double x:Key="NavigationViewCompactPaneLength">40</x:Double>
            <Thickness x:Key="NavigationViewItemPadding">10,0,10,0</Thickness>
            <Thickness x:Key="NavigationViewContentGridMargin">0,0,0,0</Thickness>
            <x:Double x:Key="NavigationViewItemIconBoxSize">18</x:Double>

            <!-- Общие отступы страниц -->
            <Thickness x:Key="PagePadding">12</Thickness>

            <!-- Compact для контролов -->
            <Thickness x:Key="TextBoxPadding">4,6,4,6</Thickness>
            <Thickness x:Key="ButtonPadding">8,4,8,4</Thickness>
            <Thickness x:Key="CheckBoxPadding">4,2,4,2</Thickness>
            <Thickness x:Key="RadioButtonPadding">4,2,4,2</Thickness>
        </ResourceDictionary>
    </Application.Resources>
</Application>